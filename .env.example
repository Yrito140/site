# --- База данных ---
# Локально (docker compose): host = localhost, из контейнера app: host = db
DATABASE_URL="postgresql://marafon:marafon@localhost:5432/marafon?schema=public"

# --- NextAuth ---
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="replace-me-with-32-byte-random-string"
AUTH_URL="http://localhost:3000"
# В прод за реверс-прокси обязательно true
AUTH_TRUST_HOST=true

# --- Публичный адрес приложения (ссылки в письмах) ---
APP_URL="http://localhost:3000"

# --- Почта (Resend) ---
# Пусто -> письма пишутся в консоль сервера, регистрация и сброс продолжают работать
RESEND_API_KEY=""
EMAIL_FROM="Marafon <noreply@example.com>"

# --- Хранилище файлов ---
# local | s3 (S3-совместимое: Cloudflare R2, AWS S3, MinIO)
# На Vercel ФС read-only — там обязательно s3.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./public/uploads"
STORAGE_PUBLIC_PREFIX="/uploads"

# --- S3 (нужно, если STORAGE_DRIVER=s3) ---
# R2: endpoint https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_PREFIX="/uploads"

# --- Деплой ---
# Vercel: пусто (standalone не нужен). Docker: true.
BUILD_STANDALONE=""
# Seed удаляет пользовательские данные — на проде только осознанно.
SEED_ALLOW_WIPE="no"

# --- Первый администратор (создаётся при seed) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
